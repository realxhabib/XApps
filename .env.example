# Copy to apps/web/.env.local. Without these, XApps runs in local demo mode
# (personas, bots and a simulated crowd — all data stays in the browser).

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_…) — or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Leave blank to detect which X provider is enabled in Supabase, or force
# "x" (X / Twitter OAuth 2.0) or "twitter" (legacy OAuth 1.0a).
NEXT_PUBLIC_SUPABASE_X_PROVIDER=

# Public URL of this site, used for share links and social preview images.
# (Sign-in always returns to the address it started on.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Grok finds memes going viral on X for Meme Duel's "Trending" picks.
# Server-only (never NEXT_PUBLIC_). Without it, Trending shows imgflip's popular
# templates. X Search is billed per post fetched, so results are cached.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# TRENDING_MEMES_REFRESH_HOURS=6
