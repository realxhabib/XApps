# Copy to apps/web/.env.local. Without these, XApps runs in local demo mode
# (personas, bots and a simulated crowd — all data stays in the browser).

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_…) — or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. "x" = X / Twitter (OAuth 2.0), "twitter" = legacy OAuth 1.0a.
# Sign-in uses whichever one is enabled in Supabase; this only picks if both are.
NEXT_PUBLIC_SUPABASE_X_PROVIDER=x

# Public URL of this site, used for share links and social preview images.
# (Sign-in always returns to the address it started on.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
