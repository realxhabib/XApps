{
  "name": "@xapps/sdk",
  "version": "0.1.0",
  "description": "Build head-to-head social apps for the XApps marketplace: identity, realtime rooms, matchmaking results, crowd voting and host UI in one tiny bridge.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "19.2.8",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "xapps",
    "x",
    "twitter",
    "multiplayer",
    "mini-games",
    "sdk",
    "realtime"
  ]
}
